# SPDX-License-Identifier: GPL-2.0-only
# Congestion-control/networking capabilities required by linux-tcp-cc.
# This fragment deliberately avoids aggressive subsystem pruning; the final
# userspace architecture config will be introduced after the runtime boots.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
