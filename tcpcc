#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Source-tree convenience only. `make install` installs the C binary directly.
set -eu
TCPCC_SOURCE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
: "${TCPCC_KERNEL:=$TCPCC_SOURCE_ROOT/.build/tcpcc-bootstrap-out/vmlinux}"
export TCPCC_KERNEL
exec "$TCPCC_SOURCE_ROOT/.build/native/tcpcc" "$@"
