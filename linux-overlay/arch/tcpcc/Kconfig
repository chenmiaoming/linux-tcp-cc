config TCPCC
	def_bool y
	depends on !SMP && !COREDUMP && !COMPAT
	select ARCH_CONFIGURES_CPU_MITIGATIONS
	select FLATMEM
	select GENERIC_CLOCKEVENTS
	select HAVE_LD_DEAD_CODE_DATA_ELIMINATION
	select HAVE_PAGE_SIZE_4KB
	select NO_DMA
	select NO_PREEMPT
	select PAGE_REPORTING
	select THREAD_INFO_IN_TASK
	select UACCESS_MEMCPY
	select GENERIC_STRNCPY_FROM_USER
	select GENERIC_STRNLEN_USER

# These are architecture-owned capability symbols in Linux 6.18.  Defining
# them, rather than selecting otherwise-undefined symbols, pulls in the generic
# delay calibration and software hweight implementations from the core tree.
config GENERIC_CALIBRATE_DELAY
	def_bool y

config GENERIC_HWEIGHT
	def_bool y

config 64BIT
	def_bool y

config MMU
	def_bool n

# The first userspace port has no process coredump ABI. Keeping this disabled is
# also required by the architecture contract above; a later change must add a
# real implementation before enabling it.
config COREDUMP
	def_bool n

config CPU_BIG_ENDIAN
	def_bool n

config GENERIC_CSUM
	def_bool y

config NO_IOPORT_MAP
	def_bool y

# The hosted architecture has no memory-mapped devices.  Linux references this
# negative capability but does not provide a generic definition for it.
config NO_IOMEM
	def_bool y

config HZ
	int
	default 100

config NR_CPUS
	int
	range 1 1
	default 1

config STACKTRACE_SUPPORT
	def_bool n

config BUILTIN_CMDLINE
	string "Built-in kernel command string"
	default ""
