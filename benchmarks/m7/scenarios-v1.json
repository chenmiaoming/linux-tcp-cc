{
  "schema_version": 1,
  "scenarios": {
    "hosted-lossless-delayed-50ms": {
      "parity_scenario_id": "lossless-delayed-50ms-v1",
      "description": "Deterministic lossless 50 ms ACK-path-delay scenario for the tcpcc hosted path.",
      "network": {
        "tun_name": "tcpcc-bdp",
        "host_ipv4": "192.0.2.1",
        "guest_ipv4": "192.0.2.2",
        "sender_ipv4": "192.0.2.2",
        "receiver_ipv4": "192.0.2.1",
        "mtu": 1500,
        "netem_direction": "receiver_to_sender_ack_path",
        "delay_ms": 50,
        "loss_percent": 0,
        "limit_packets": 10000
      },
      "topology_bindings": {
        "tcpcc": "host TUN egress delays host-to-guest ACK traffic"
      },
      "transfer": {
        "congestion_controls": [
          "cubic",
          "bbr"
        ],
        "guest_to_host_bytes_per_cc": 2097152,
        "host_to_guest_bytes_per_cc": 16384
      },
      "acceptance": {
        "min_rtt_fraction_of_delay": 0.6,
        "require_qdisc_dropped_zero": true,
        "require_established": true,
        "require_nonzero_rto": true,
        "require_nonzero_rtt": true,
        "require_nonzero_cwnd": true,
        "require_bbr_pacing": true
      },
      "tcp_loss_counters": {
        "policy": "observational_not_gated_m7_1",
        "reason": "TCP lost/retrans/total_retrans remain observational; the lossless gate applies to the configured zero-loss qdisc instead of assuming runtime scheduling cannot trigger TCP recovery."
      }
    }
  }
}
