# M7 native reference additions on top of virtme-ng's bootable minimal config.
CONFIG_LOCALVERSION_AUTO=n
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_INET=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_CUBIC=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_NETEM=y
CONFIG_VETH=y
